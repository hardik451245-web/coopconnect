{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter @workspace/coopconnect --filter @workspace/api-server run dev",
    "dev:frontend": "corepack pnpm --filter @workspace/coopconnect run dev",
    "dev:backend": "corepack pnpm --filter @workspace/api-server run dev",
    "dev:all": "corepack pnpm -r --parallel --filter @workspace/coopconnect --filter @workspace/api-server run dev",
    "preinstall": "node -e \"if (process.env.npm_config_user_agent && !process.env.npm_config_user_agent.startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
